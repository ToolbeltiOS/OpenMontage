{
  "_comment": "Buildability contract. The scene-plan validator reads this to fail a slot BEFORE a render is attempted. Zod schemas in src/schemas/docComponents.ts enforce the same shape at render time; this file is the build-time half so Python tooling does not need a TypeScript step.",
  "_why": "Run #1 reached compose with 79 slots naming graphics that had no component behind them. They were descriptions, not scenes. Nothing checked.",
  "components": {
    "annotated_still": {
      "required": [
        "image"
      ],
      "optional": [
        "parallax",
        "parallaxFrom",
        "parallaxTo",
        "annotations",
        "measurement",
        "cutaway",
        "caption",
        "dim",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "source",
        "title"
      ],
      "array_item_required": {
        "annotations": [
          "label",
          "x",
          "y",
          "reveal_at"
        ]
      },
      "purpose": "default for cross-section / diagram slots — a real still with timed annotations"
    },
    "schematic": {
      "required": [
        "layers"
      ],
      "optional": [
        "viewBox",
        "reveals",
        "labels",
        "title",
        "caption",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "source"
      ],
      "array_item_required": {
        "layers": [
          "id",
          "kind"
        ],
        "reveals": [
          "layer_id",
          "at",
          "effect"
        ],
        "labels": [
          "text",
          "x",
          "y",
          "at"
        ]
      },
      "enums": {
        "layers.kind": [
          "path",
          "rect",
          "circle",
          "line",
          "text",
          "polyline"
        ],
        "reveals.effect": [
          "draw",
          "fade",
          "slide-in"
        ],
        "labels.level": [
          "label",
          "data"
        ]
      },
      "purpose": "authored vector section with a timed reveal — mechanisms a photo cannot show"
    },
    "map_route": {
      "required": [
        "route"
      ],
      "optional": [
        "markers",
        "center",
        "scale",
        "draw_seconds",
        "draw_at",
        "distance_callout",
        "title",
        "caption",
        "arc",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "source",
        "basemap",
        "basemap_drift"
      ],
      "array_item_required": {
        "markers": [
          "lon",
          "lat",
          "label",
          "at"
        ]
      },
      "purpose": "route drawn over real geography (d3-geo + world-atlas)"
    },
    "globe_descent": {
      "required": [
        "lon",
        "lat"
      ],
      "optional": [
        "seconds",
        "handoff_seconds",
        "texture"
      ],
      "purpose": "a descent from a dark globe to one place over 3-4s, handing off to the 2D map for the same extent; WebGL, so it needs --gl=angle on an M1"
    },
    "timeline": {
      "required": [
        "events"
      ],
      "optional": [
        "orientation",
        "span",
        "playhead",
        "title",
        "caption",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "source"
      ],
      "array_item_required": {
        "events": [
          "year",
          "label",
          "at"
        ]
      },
      "enums": {
        "orientation": [
          "horizontal",
          "vertical"
        ]
      },
      "purpose": "BC/AD chronology with a moving playhead"
    },
    "document_reveal": {
      "required": [
        "lines"
      ],
      "optional": [
        "headline",
        "source",
        "image",
        "paper",
        "light_sweep",
        "sweep_at",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "caption"
      ],
      "array_item_required": {
        "lines": [
          "text",
          "at"
        ]
      },
      "enums": {
        "paper": [
          "light",
          "dark"
        ]
      },
      "purpose": "paper-grain quote reveal with a raking light sweep"
    },
    "text_card": {
      "required": [
        "text"
      ],
      "optional": [
        "fontSize",
        "color",
        "backgroundColor"
      ],
      "purpose": "stock"
    },
    "stat_card": {
      "required": [
        "stat"
      ],
      "optional": [
        "subtitle",
        "accentColor"
      ],
      "purpose": "stock"
    },
    "callout": {
      "required": [
        "text"
      ],
      "optional": [
        "callout_type",
        "title"
      ],
      "purpose": "stock"
    },
    "comparison": {
      "required": [
        "leftLabel",
        "rightLabel",
        "leftValue",
        "rightValue"
      ],
      "optional": [
        "title"
      ],
      "purpose": "stock"
    },
    "hero_title": {
      "required": [
        "text"
      ],
      "optional": [
        "heroSubtitle"
      ],
      "purpose": "stock"
    },
    "anime_scene": {
      "required": [
        "images"
      ],
      "optional": [
        "particles",
        "lightingFrom",
        "lightingTo",
        "vignette"
      ],
      "purpose": "stock — stills with particles + camera motion"
    },
    "section_title": {
      "required": [
        "text"
      ],
      "optional": [
        "accentColor",
        "position"
      ],
      "purpose": "stock overlay — lower third"
    },
    "stat_reveal": {
      "required": [
        "text"
      ],
      "optional": [
        "subtitle",
        "accentColor",
        "position"
      ],
      "purpose": "stock overlay"
    },
    "bar_chart": {
      "required": [
        "chartData"
      ],
      "optional": [
        "chartAnimation",
        "showValues",
        "showGrid"
      ],
      "purpose": "stock"
    },
    "line_chart": {
      "required": [
        "chartSeries"
      ],
      "optional": [
        "chartAnimation",
        "xLabel",
        "yLabel"
      ],
      "purpose": "stock"
    },
    "pie_chart": {
      "required": [
        "chartData"
      ],
      "optional": [
        "donut",
        "centerLabel",
        "centerValue"
      ],
      "purpose": "stock"
    },
    "kpi_grid": {
      "required": [
        "chartData"
      ],
      "optional": [
        "title",
        "columns"
      ],
      "purpose": "stock"
    },
    "progress_bar": {
      "required": [
        "progress"
      ],
      "optional": [
        "progressLabel",
        "progressColor"
      ],
      "purpose": "stock"
    },
    "act_title_card": {
      "required": [
        "act",
        "title"
      ],
      "optional": [
        "epigraph",
        "image",
        "fade_in",
        "fade_out"
      ],
      "purpose": "act boundary card — the one scene with no persistent chrome, carrying its own fade in/out so it lives inside the fade-through-black at the act change"
    },
    "title_sequence": {
      "required": [
        "title"
      ],
      "optional": [
        "channel",
        "kicker",
        "image",
        "sting_at",
        "fade_in",
        "fade_out"
      ],
      "purpose": "the film's own title card, 6-8s after the cold open — title in Display over a treated hero still, channel mark, and one accent event landing on the sting; no persistent chrome, like the act card"
    },
    "before_after": {
      "required": [
        "before",
        "after"
      ],
      "optional": [
        "before_label",
        "after_label",
        "mode",
        "at",
        "wipe_seconds",
        "rest",
        "title",
        "caption",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "source"
      ],
      "purpose": "two framings of ONE subject either side of a travelling or fixed divider, for plate-and-detail beats and for restoration / then-now beats; both plates take the same grade so the visible difference is the material, not the treatment. A then-now pair must be two REAL plates from two real eras — ageing or desaturating a modern photograph to stand in for an archival one is a false claim about the evidence and is forbidden. With no matched pair in the bank, the beat is not a before_after."
    },
    "evidence_card": {
      "required": [
        "claim",
        "attribution"
      ],
      "optional": [
        "index",
        "detail",
        "status",
        "caption",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "source"
      ],
      "enums": {
        "status": [
          "peer_reviewed",
          "contested",
          "unpublished",
          "measured",
          "claim"
        ]
      },
      "purpose": "the citation beat — who established a thing, which no photograph can show. The status chip is what stops a contested claim reading as settled"
    },
    "scale_comparison": {
      "required": [
        "items",
        "unit"
      ],
      "optional": [
        "decimals",
        "title",
        "footnote",
        "caption",
        "at",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "coords",
        "kicker",
        "source"
      ],
      "array_item_required": {
        "items": [
          "label",
          "value"
        ]
      },
      "min_items": {
        "items": 2
      },
      "purpose": "comparative magnitude — bars plus counted figures, for the numbers narration cannot make felt. Two items minimum: one bar compares nothing"
    },
    "outro_cta": {
      "required": [],
      "optional": [
        "channel",
        "filmTitle",
        "eyebrow",
        "line1",
        "line2",
        "scheduleLine",
        "backgroundSrc",
        "likeAt",
        "subscribeAt",
        "fadeOutSeconds"
      ],
      "defaults_supplied_by_schema": true,
      "purpose": "the default end card for every narrated-documentary film: dimmed hero still, headline, drawn like / subscribe / bell timed to the narration, schedule line. Left two thirds only — the right third and bottom fifth stay clear for YouTube End Screen elements. No platform marks.",
      "timing": "likeAt and subscribeAt are seconds into THIS scene, taken from the word-level captions for the words 'like' and 'subscribe'."
    },
    "texture_field": {
      "required": [
        "kind",
        "seed"
      ],
      "optional": [
        "density",
        "angle",
        "speed",
        "actNumber",
        "actTitle",
        "sceneIndex",
        "caption"
      ],
      "enums": {
        "kind": [
          "dust",
          "strata",
          "grain_drift",
          "depth_field",
          "scanline"
        ]
      },
      "purpose": "authored texture for when the screened clip bank runs out. The reuse rule allows each clip once; with 41 texture beats and 28 clips, the remainder is authored rather than repeated. Seed + kind + density + angle make each instance a distinct configuration."
    }
  },
  "_chrome": {
    "props": [
      "actNumber",
      "actTitle",
      "sceneIndex",
      "coords",
      "kicker",
      "source"
    ],
    "why": "The persistent frame layer. Accepted by every documentary scene type and listed in each component's `optional`, so a slot cannot invent its own furniture names."
  }
}
