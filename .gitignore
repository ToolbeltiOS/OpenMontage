# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Local model downloads (e.g. Piper TTS voices, fetched at runtime — not source)
*.onnx
*.onnx.json

# Test/IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.trae/
.idea/
.vscode/

# Pipeline outputs (regenerable — never commit large media)
output/
pipeline/
tests/qa/output/

# Project workspaces. Media, renders, proxies, caches and contact sheets are
# regenerable and stay out. The JSON decision records are NOT: edit_decisions
# carries the music the owner chose by ear and the by-name rejected list,
# scene_plan carries the asset assignment that satisfies the reuse rule, and
# run1_assignment is the frozen baseline the repair pass is measured against.
# Losing them loses decisions, not bytes, so those files are tracked.
#
# Re-including a file needs every directory on its path re-included first,
# which is what the bare `!projects/*/` lines below are for.
projects/**
!projects/*/
!projects/*/artifacts/
!projects/*/artifacts/edit_decisions.json
!projects/*/artifacts/sound_design.json
!projects/*/artifacts/narration_plan.json
!projects/*/artifacts/scene_plan.json
!projects/*/artifacts/research_brief.json
# EVERY asset bank, not just the one spelling. The fetcher writes
# asset_bank_deep.json and asset_bank_small.json beside asset_bank.json, and
# a builder that read only the first spelling left 18 CC BY-SA Wikimedia
# images out of easter-island's credits — attribution is a CONDITION of that
# licence. The glob is the point: a bank that exists and is not tracked is a
# licence record that exists on one laptop.
!projects/*/artifacts/asset_bank*.json
# The Pixabay texture clips are screened OUTSIDE the bank, which is how the
# other 18 missing credits were lost. This is their only licence record.
!projects/*/artifacts/texture_screening.json
!projects/*/artifacts/run1_assignment.json
!projects/*/artifacts/metadata.json
!projects/*/artifacts/publish.json
# script.json is the AUTHORED TEXT and derived_assets.json is the RIGHTS
# PROVENANCE of every crop, loop and upscale the film cut to. Neither can be
# recomputed, both of their neighbours in the chain are tracked, and nine
# tests read them — tests which passed only in the checkout that happened to
# produce the files and failed in the runner worktree, where a published
# film's own provenance did not exist.
!projects/*/artifacts/script.json
!projects/*/artifacts/derived_assets.json
# Per-film illustration approvals. A verdict exists because a person replied
# to the illustration gate, so it is a decision and decisions are kept. It
# replaced one shared tracked file for all films — see
# lib/illustration_spec.APPROVALS.
!projects/*/artifacts/illustration_approvals.json
# listing.json is the PUBLISHED RECORD: the title, description, chapters and
# the credit for every asset the film used. It is what the film claims about
# itself and about whose work is in it, so it is tracked. render_props.json
# is not — that is rebuilt from edit_decisions every render.
!projects/*/artifacts/listing.json
!projects/*/renders/
!projects/*/renders/mix_report.json

# Corpus directories (downloaded stock clips, thumbnails, embeddings —
# regenerable from source APIs via corpus_builder). Explicit rule even
# though most corpora live under projects/ since agents sometimes
# build scratch corpora at the repo root.
corpus/
**/corpus/

# User music library (personal royalty-free tracks — not part of repo)
music_library/

# Environment & credentials
.env
.env.local
*.env
.youtube-token.json
# Google service-account / Vertex AI keys — never commit
gcp-*.json
*-service-account.json
service-account*.json
service_account*.json

# Stray media downloads (test/scratch clips left in repo root)
pexels_video_*.mp4

# Scratch/debug scripts
scratch/

# Internal docs (strategy, handoffs, playbooks — not shipped)
internal/

# Local agent config (user-specific)
.claude/memory/
.claude/settings.local.json

# Agent skills lock (local install tracking)
skills-lock.json

# Generated images (logo drafts — final logo lives in assets/)
logo_*.png
generated_image.png

# Downloaded music files (Pixabay, Freesound — not source code)
pixabay_music_*

# OS
.DS_Store
Thumbs.db

# Node (for remotion-composer/)
node_modules/

# Remotion build output and copied project assets (regenerable at render time)
remotion-composer/out/
# Project-local bespoke ("atelier") compositions — hand-authored per video,
# throwaway and regenerable. Keeps the shared src/ free of one-off scenes.
remotion-composer/projects/
remotion-composer/public/*
# But keep demo props (shipped with the project for zero-key demos)
# The house library, symlinked so 18MB is not duplicated into the
# bundle. The link is tracked; its target is assets/library/.
!remotion-composer/public/library
!remotion-composer/public/demo-props/
# Keep the two stills the wak3up-documentary component demos render against,
# so a fresh clone can run them. Both Wikimedia Commons, CC BY-SA, attributed
# in the demo captions.
!remotion-composer/public/doc/
# Ignore test/scratch compositions in demo-props (keep only curated demos)
remotion-composer/public/demo-props/test-*
remotion-composer/public/demo-props/talking-head-*
remotion-composer/public/demo-props/caption-burn-*

venv/
.venv/
# WITHOUT THE SLASH TOO, because a trailing slash matches a DIRECTORY and
# git treats a symlink as a file. The runner worktree symlinks .venv and
# node_modules at the main checkout's copies rather than duplicating
# gigabytes, and those symlinks showed as untracked — which would leave the
# runner tree permanently dirty and make run_weekly.sh refuse to start on
# its own clean-tree guard.
.venv
remotion-composer/node_modules

# Backlot local cache (thumbnails)
.backlot/

# Workspace-local third-party runtimes (for example the portable Blender LTS
# used by blender_world). These are checksum-verified but never committed.
.runtime/

# Local Wan / diffusers GPU environment
.venv-wan/

# Natural Earth terrain raster (700MB, public domain, re-downloadable)
assets/basemaps/
!projects/*/artifacts/demo_act2_props.json

# Critic contact sheets (regenerable)
reports/critic/

# Phase 2B — weekly run working files
logs/
artifacts/metrics/
*.lock

# THE PUBLISHED LEDGER IS NOT IN THE REPOSITORY.
#
# It was tracked here, which gave it one copy per branch. Noah was published
# out of the `asset-library` worktree on 2026-11-02 and appended to that
# branch's copy; the runner, pinned to `automation`, read its own copy — which
# ended at Easter Island — and picked Noah again on 2026-11-06.
#
# The channel has one past, so the ledger has one file, outside every
# worktree: ~/Developer/wak3up-docs/state/published.json (lib/shared_state.py,
# overridable with WAK3UP_DOCS_STATE). This line is here so that a copy
# written into a tree by an older script, or by hand, cannot be committed back
# into a branch and become a second answer.
artifacts/published.json

# The DepthFlow renderer needs Python 3.11+ (shaderflow imports typing.Self)
# and the pipeline runs on 3.10, so it gets its own interpreter.
.venv-depth/
