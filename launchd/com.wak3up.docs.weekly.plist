<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.wak3up.docs.weekly</string>

    <!-- Friday 19:00 local time. Weekday 5 is Friday; 0 is Sunday.

         This file said "Friday 22" in a comment and SUNDAY 06:00 in the
         keys, which is not the same day, let alone the same hour.

         19:00 so the heavy claude -p stages start at the top of a fresh
         usage window and are finished before Saturday's work wants one. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>5</integer>
        <key>Hour</key><integer>19</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mac/Developer/wak3up-docs/runner/scripts/run_weekly.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mac/Developer/wak3up-docs/runner</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- The runner has its OWN WORKTREE, pinned to RUN_BRANCH.
             It used to point at the development checkout, and on
             2026-10-30 that produced a whole film from the unmerged
             asset-library branch because the checkout had been left
             there. A worktree cannot be switched by someone working
             on another branch; run_weekly.sh also refuses to start
             if it finds itself on the wrong branch or dirty. -->
        <key>REPO</key><string>/Users/mac/Developer/wak3up-docs/runner</string>
        <key>RUN_BRANCH</key><string>automation</string>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/mac/.local/bin</string>
        <key>HOME</key><string>/Users/mac</string>
    </dict>

    <!-- If the Mac was asleep at the scheduled minute, run on wake. A
         missed Friday is a missed week. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/mac/Developer/wak3up-docs/runner/logs/com.wak3up.docs.weekly.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mac/Developer/wak3up-docs/runner/logs/com.wak3up.docs.weekly.err.log</string>

    <!-- A render is the whole machine for an hour; nice it so the Mac stays
         usable if anyone is awake. -->
    <key>Nice</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
